# Copy Studio 服务端配置模板
#
# 用法：复制本文件为 server/.env 后填入真实值
#   cp server/.env.example server/.env
#
# 安全约束：
#   - server/.env 已被 .gitignore 排除，git add 会拒绝；请勿用 -f 强制加入。
#   - 本文件（.env.example）只放占位符，禁止填入任何真实密钥。
#   - LLM_API_KEY 是上游模型密钥，仅服务端读取，绝不下发浏览器。
#   - X-API-Key 是 Copy Studio 的访问密钥，与上游密钥无关，可分发给门店。

# ---------- LLM 上游（必填） ----------
# 上游密钥。默认上游为商汤 SenseNova（sk- 开头），也支持 NVIDIA（nvapi- 开头）等
# OpenAI 兼容端点。填 LLM_API_KEY 或 SENSENOVA_API_KEY 均可，LLM_API_KEY 优先。
# 坑：若 LLM_API_KEY 里留着旧 NVIDIA Key，即使 BASE 指向商汤也会用旧 Key 去打商汤 → 401。
#     换上游时请一并清空或覆盖 LLM_API_KEY。
LLM_API_KEY=
# OpenAI 兼容上游地址（代码默认值即商汤 SenseNova）
LLM_API_BASE=https://token.sensenova.cn/v1
# 服务端固定模型，客户端不可覆盖。换上游时须换成该上游支持的模型 ID，否则 404。
# 商汤可选：deepseek-v4-flash（默认）/ sensenova-6.8-flash-lite / glm-5.2 / kimi-k3 / deepseek-v4-pro
# 注意：sensenova-u1-fast、sensenova-u1.5-lite 是图像生成专用，不可作为对话模型。
LLM_MODEL=deepseek-v4-flash

# ---------- 服务监听 ----------
HOST=127.0.0.1
PORT=8765

# ---------- 鉴权（云端部署必须为 true） ----------
# 云端/非回环部署时，启动守卫会强制要求已配置密钥
REQUIRE_AUTH=false
# 多租户映射，格式：门店A:密钥A,门店B:密钥B
TENANT_KEYS=
# 兼容的访问密钥列表，逗号分隔
API_KEYS=

# ---------- CORS ----------
# 允许访问后端的前端来源，逗号分隔
CORS_ORIGINS=
# 是否允许 Origin: null（file:// 页面）。开启后强制要求已配置密钥
CORS_ALLOW_NULL=false

# ---------- 数据 ----------
# SQLite 数据目录，已排除出 Git
DATA_DIR=server/.data
DB_PATH=
# 单条记录最大字节数
DB_MAX_PAYLOAD_BYTES=

# ---------- 请求体上限 ----------
LLM_MAX_BODY_BYTES=
EXTRACT_MAX_BODY_BYTES=

# ---------- 视频提取 / SSRF 边界 ----------
# 是否允许下载公网 URL（默认仅处理上传文件）
ALLOW_REMOTE_URL=false
# 允许的媒体主机白名单，逗号分隔
MEDIA_HOST_ALLOWLIST=

# ---------- 仅本地开发用 ----------
# 允许上游走明文 http（本地 mock 调试用）。生产环境切勿开启。
ALLOW_INSECURE_LLM_HTTP=false

# ---------- 分布式限流（可选）----------
# 多 worker / 多 host 部署需要集中配额时设置。设为空或不设置则使用内存后端。
# 启用前先 pip install 'redis>=5.0'；redis 不可达时自动回退内存并打 WARNING（fail open）。
# RATE_LIMIT_URL=redis://:password@your-redis-host:6379/0
